# Copy to .env and fill in. All values below are optional except the API key.
ANTHROPIC_API_KEY=

# Embeddings. "all-MiniLM-L6-v2" runs locally via Chroma's bundled ONNX model.
# Any other name is loaded with sentence-transformers (pip install sentence-transformers).
EMBEDDING_MODEL=all-MiniLM-L6-v2

LLM_PROVIDER=anthropic
LLM_MODEL=claude-opus-5

CHUNK_SIZE=250
CHUNK_OVERLAP=40
# TOP_K chunks reach the LLM. With a reranker, RETRIEVAL_CANDIDATES are retrieved
# first and a cross-encoder picks the best TOP_K. Set RERANKER_MODEL= (empty) to disable.
TOP_K=5
RETRIEVAL_CANDIDATES=15
RERANKER_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
MIN_RELEVANCE_SCORE=0.25

# Leave empty for an in-memory Chroma (data is lost on restart).
CHROMA_PERSIST_DIR=./chroma_data
MAX_UPLOAD_MB=25

# Retrieval mode: "dense" or "hybrid" (BM25 + dense with reciprocal rank fusion)
RETRIEVAL_MODE=hybrid

# Used by the Streamlit UI and the eval script
API_URL=http://localhost:8000
